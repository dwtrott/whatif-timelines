# Same variable names go-mirofish uses, so an existing .env drops in.
# Pick ONE provider. Presets: openai | groq | gemini | openrouter | cerebras | ollama | mock
WHATIF_PROVIDER=openai
LLM_API_KEY=sk-...
# Optional overrides (presets fill these in):
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# WHATIF_CONCURRENCY=4      # parallel LLM calls (free tiers: 2-3)
# WHATIF_RPM=0              # requests/min limiter, 0 = off
# WHATIF_BRIEF_CHARS=9000   # briefing size per agent call (smaller = cheaper)
# WHATIF_DATA_DIR=data
